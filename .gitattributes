# Auto detect text files and perform LF normalization
* text=auto

# Text files
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.exe binary
*.dll binary

# Virtual environment - treat as binary
debt_collection/** binary
venv/** binary
.venv/** binary